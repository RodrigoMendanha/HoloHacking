# ---------------------------------------------------------------------------
# Casos clinicos reais = dado pessoal sensivel (LGPD art. 5 II e art. 11).
# Nunca versionar. Uma vez commitado, fica na historia do repositorio para sempre,
# mesmo que o arquivo seja apagado depois.
# Os casos ficticios de teste (exemplo-*) sao a unica excecao.
# ---------------------------------------------------------------------------
Holos AI/motor/casos/*
!Holos AI/motor/casos/exemplo-*.json

# Material bruto do metodo (livro, aulas, apostilas) vive no Drive, nao aqui.
# As transcricoes processadas entram depois, em pasta propria e por decisao explicita.
material-bruto/
**/material/
*.pdf
*.docx
*.doc
*.pptx
*.xlsx
*.mp4
*.mov
*.mp3
*.m4a
*.wav

node_modules/
.next/
.env.local
.DS_Store
Thumbs.db

# Indice derivado e material bruto do metodo — reconstruiveis, nao versionar
Holos AI/motor/corpus/indice.json
Holos AI/motor/corpus/fontes/*
!Holos AI/motor/corpus/fontes/README.md

# Cache do Python (o extrator roda uma vez, o .pyc nao interessa a ninguem)
__pycache__/
*.pyc

# Artefato gerado por "npm run bancos". Sai dos CSV, nao se versiona.
Holos AI/motor/build/

